# Copy to .env for local development. On Render these are set in the dashboard.
# Leave DATABASE_URL unset locally to fall back to a local SQLite file.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
SECRET_KEY=change-me-to-a-long-random-string
ANNOTATOR1_PASSWORD=
ANNOTATOR2_PASSWORD=
ANNOTATOR3_PASSWORD=
ADMIN_TOKEN=
